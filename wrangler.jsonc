{
  // The built pages from dist/, plus worker/index.ts for /api/*: /api/firmware/*
  // writes owners' firmware to a private bucket (no public URL), and the rest takes
  // owners' reports on what works into D1 (worker/reports.ts)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arewearmyet",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api", "/api/*"]
  },
  "routes": [{ "pattern": "arewearmyet.com", "custom_domain": true }],
  // 04:23 UTC every night: worker/backup.ts copies the reports database to the bucket
  "triggers": { "crons": ["23 4 * * *"] },
  // Keeps the Worker's logs, so failed requests and the backup can be looked up
  "observability": { "enabled": true },
  "r2_buckets": [{ "binding": "FIRMWARE", "bucket_name": "arewearmyet-firmware" }],
  "d1_databases": [{ "binding": "DB", "database_name": "arewearmyet", "database_id": "94816cb7-cac5-4adc-8a0c-51a6c8e1e32f", "migrations_dir": "migrations" }],
  "ratelimits": [
    { "name": "UPLOAD_LIMIT", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "REPORT_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  // "off" closes the firmware drop or the reports without a code change.
  // ADMIN_TOKEN, for hiding reports from /review, is a secret (wrangler secret put ADMIN_TOKEN)
  // REBUILD_TOKEN, a GitHub token with Actions write on the repository, lets new results start a
  // build of the site (worker/rebuild.ts). Without it the site follows them once a day
  "vars": { "FIRMWARE_UPLOADS": "on", "REPORTS": "on" }
}
