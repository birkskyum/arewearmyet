{
  // The built pages from dist/, plus worker/index.ts for /api/firmware/*,
  // which writes owners' firmware to a private bucket (no public URL)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arewearmyet",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "arewearmyet.com", "custom_domain": true }],
  "r2_buckets": [{ "binding": "FIRMWARE", "bucket_name": "arewearmyet-firmware" }],
  "ratelimits": [{ "name": "UPLOAD_LIMIT", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } }],
  // "off" closes the drop without a code change
  "vars": { "FIRMWARE_UPLOADS": "on" }
}
