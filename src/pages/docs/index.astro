---
// Where every piece of documentation is, for owners, agents and anyone building on the data
import DocsLayout from '../../layouts/DocsLayout.astro';
import { DOC_GROUPS } from '../../lib/docs';
---

<DocsLayout title="Docs · Are we ARM yet?" description="Documentation for arewearmyet.com: installing Omarchy on an ARM PC, the hw-test hardware test, the guide for AI agents and the API.">
  <h1 class="text-3xl font-bold tracking-tight text-zinc-50 sm:text-4xl">Docs</h1>
  {DOC_GROUPS.map((group) => (
    <section class="mt-8">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-zinc-500">{group.title}</h2>
      <ul class="mt-3 space-y-3">
        {group.pages.map((page) => (
          <li>
            <a href={page.href} class="block rounded-xl p-5 ring-1 ring-zinc-800 hover:bg-zinc-900 hover:ring-zinc-700">
              <span class="font-semibold text-zinc-100">{page.title}</span>
              <span class="mt-1 block text-sm">{page.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
  <p class="mt-10 text-xs text-zinc-500">
    Plain text for agents: <a class="underline decoration-zinc-600 underline-offset-2 hover:text-zinc-100" href="/llms.txt">/llms.txt</a>
  </p>
</DocsLayout>
