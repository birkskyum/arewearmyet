---
import Layout from '../layouts/Layout.astro';
import Legend from '../components/Legend.astro';
import SplitBar from '../components/SplitBar.astro';
import StatusTable from '../components/StatusTable';
import OmarchyIcon from '../assets/omarchy-icon.svg';
import status from '../data/status.json';
import { ANNOUNCED, LEGEND, NVIDIA_LEGEND, TONE } from '../lib/labels';
import { PILL } from '../lib/tones';
import { nvidiaRows, snapdragonRows } from '../lib/rows';

const { summary } = status;
const channel = status.omarchy.channel.toUpperCase();
const byName = <T extends { vendor: string; name: string }>(a: T, b: T) => a.vendor.localeCompare(b.vendor) || a.name.localeCompare(b.name);
const rows = snapdragonRows().sort(byName);
const nvidia = nvidiaRows().sort((a, b) => a.generation.localeCompare(b.generation) || byName(a, b));
const vendors = [...new Set(rows.map((row) => row.vendor))];

// What owners saw first, then what the pieces predict
const outcomeBar = [
  { label: 'Works', value: summary.works, color: 'bg-emerald-400', title: 'An owner confirmed the current Omarchy release runs on it.' },
  { label: 'Should work', value: summary.should, color: 'bg-amber-400', title: 'Every piece is in place, but no owner has confirmed it yet.' },
  { label: 'Problems', value: summary.problems, color: 'bg-rose-400', title: 'An owner reported it failing.' },
  { label: 'Not yet', value: summary.notYet, color: 'bg-zinc-600', title: 'Pieces are still missing.' },
];
const nvidiaBar = [
  { label: 'Works', value: summary.nvidiaWorks, color: 'bg-emerald-400', title: 'Someone ran Omarchy on it.' },
  { label: 'Should work', value: summary.nvidiaExpected, color: 'bg-amber-400', title: 'Same platform as a model that works.' },
  { label: 'Not tested', value: summary.nvidia - summary.nvidiaWorks - summary.nvidiaExpected, color: 'bg-zinc-600', title: 'Nobody has tried it yet.' },
];
const upstreamBars = [
  { label: 'Device tree in Linux', value: summary.deviceTree, total: summary.models, color: 'bg-sky-400', note: 'released or queued in linux-next' },
  { label: 'Hardware IDs in systemd', value: summary.ids, total: summary.models, color: 'bg-violet-400', note: 'so an image picks the device tree by itself' },
  { label: `Firmware without the laptop's Windows`, value: summary.firmware, total: summary.models, color: 'bg-amber-400', note: `in linux-firmware's newest release or a known vendor download` },
  { label: 'ACPI dump collected', value: summary.acpi, total: summary.acpiNeeded, color: 'bg-rose-400', note: 'for the models still without a device tree' },
];

const snapdragonColumns = LEGEND.map((group, i) => ({ id: ['omarchy', 'device-tree', 'ids', 'firmware', 'acpi'][i], header: group.column, question: group.question }));
const nvidiaColumns = [
  { id: 'omarchy', header: 'Omarchy', question: NVIDIA_LEGEND[0].question },
  { id: 'linux', header: 'Linux', question: NVIDIA_LEGEND[1].question },
  { id: 'notes', header: 'Notes', question: 'What else to know' },
];
const legendExtra = [
  { label: 'Green', tone: 'good' as const, meaning: 'Done.' },
  { label: 'Amber', tone: 'close' as const, meaning: 'On its way, or partly there.' },
  { label: 'Red', tone: 'wanted' as const, meaning: 'Missing or failing, and where help counts most.' },
  { label: 'Grey', tone: 'muted' as const, meaning: 'Works another way today, or not needed.' },
  ANNOUNCED,
];

const collected = new Date(status.collected).toISOString().slice(0, 10);
const LINK = 'underline decoration-zinc-600 underline-offset-2 hover:text-zinc-100 hover:decoration-zinc-300';
const REPO = 'https://github.com/birkskyum/arewearmyet';
const NAV = 'rounded-full px-3 py-1 text-zinc-300 ring-1 ring-zinc-700 hover:bg-zinc-800 hover:text-zinc-100';
const HEADLINE = 'text-2xl font-semibold text-zinc-50';
---

<Layout title="Are we ARM yet?" description="Omarchy on ARM PCs, model by model: which laptops run it today, and what each one still needs upstream.">
  <main class="mx-auto max-w-[96rem] px-4 py-10 sm:px-6 lg:px-8">
    <header>
      <div class="flex items-center gap-4">
        <a href="https://omarchy.org" title="Omarchy" class="shrink-0 text-[#9ece6a] hover:brightness-110">
          <OmarchyIcon class="h-11 w-11 sm:h-14 sm:w-14" aria-label="Omarchy" />
        </a>
        <h1 class="text-4xl font-bold tracking-tight text-zinc-50 sm:text-5xl">Are we ARM yet?</h1>
      </div>
      <p class="mt-3 text-lg text-zinc-400">Omarchy on ARM PCs, model by model.</p>
      <nav class="mt-5 flex flex-wrap gap-2 text-sm">
        <a href="#snapdragon" class={NAV}>Snapdragon X and X2 <span class="text-zinc-500">{summary.models}</span></a>
        <a href="#nvidia" class={NAV}>NVIDIA N1x and GB10 <span class="text-zinc-500">{summary.nvidia}</span></a>
        <a href="#apple" class={NAV}>Apple Silicon</a>
        <a href="#help" class={NAV}>Help a model get there</a>
      </nav>
    </header>

    <section class="mt-10 rounded-xl bg-zinc-900 p-6 ring-1 ring-zinc-800">
      <p class={HEADLINE}>
        {summary.works} of {summary.models} <a href="#snapdragon" class="hover:underline hover:decoration-zinc-500 hover:underline-offset-4">Snapdragon X and X2 models</a> run Omarchy
      </p>
      <p class="mt-1 text-sm text-zinc-400">
        Confirmed by an owner on Omarchy {channel}, which ships linux-omarchy {status.omarchy.kernel} and systemd {status.omarchy.systemd}. {summary.should} more should work, and {summary.problems} {summary.problems === 1 ? 'has' : 'have'} reported problems.
      </p>
      <div class="mt-6">
        <SplitBar parts={outcomeBar} total={summary.models} />
      </div>

      <h3 class="mt-8 text-sm font-semibold text-zinc-200">What the models have upstream</h3>
      <dl class="mt-3 space-y-4">
        {upstreamBars.map((bar) => (
          <div>
            <div class="flex items-baseline justify-between gap-4 text-sm">
              <dt class="text-zinc-200">{bar.label} <span class="text-zinc-500">{bar.note}</span></dt>
              <dd class="tabular-nums text-zinc-300">{bar.value} / {bar.total}</dd>
            </div>
            <div class="mt-1.5 h-2 overflow-hidden rounded-full bg-zinc-800">
              <div class={`h-full rounded-full ${bar.color}`} style={`width: ${(100 * bar.value) / Math.max(bar.total, 1)}%`}></div>
            </div>
          </div>
        ))}
      </dl>

      <div class="mt-8 border-t border-zinc-800 pt-6">
        <p class={HEADLINE}>
          {summary.nvidiaWorks} of {summary.nvidia} <a href="#nvidia" class="hover:underline hover:decoration-zinc-500 hover:underline-offset-4">NVIDIA N1x and GB10 machines</a> run Omarchy
        </p>
        <p class="mt-1 text-sm text-zinc-400">They boot through ACPI, so what counts is whether someone has run Omarchy on them.</p>
        <div class="mt-6">
          <SplitBar parts={nvidiaBar} total={summary.nvidia} />
        </div>
      </div>
    </section>

    <section class="mt-10 scroll-mt-6" id="snapdragon">
      <h2 class="text-xl font-semibold text-zinc-50">Snapdragon X and X2</h2>
      <div class="mt-4">
        <Legend title="What the labels mean" groups={LEGEND} extra={legendExtra} />
      </div>
      <div class="mt-4">
        <StatusTable
          client:load
          rows={rows}
          columns={snapdragonColumns}
          chips={[{ value: 'x1', label: 'X' }, { value: 'x2', label: 'X2' }, { value: '8cx', label: '8cx Gen 3' }]}
          outcomes={[{ value: 'works', label: 'Works' }, { value: 'should', label: 'Should work' }, { value: 'problems', label: 'Problems' }, { value: 'notyet', label: 'Not yet' }]}
          vendors={vendors}
        />
      </div>
    </section>

    <section class="mt-12 scroll-mt-6" id="nvidia">
      <h2 class="text-xl font-semibold text-zinc-50">NVIDIA N1x and GB10</h2>
      <p class="mt-1 max-w-3xl text-sm text-zinc-400">
        NVIDIA's ARM laptops and desktops boot through ACPI, so they need no device tree or hardware IDs. What counts here is whether someone has run Omarchy on them.
      </p>
      <div class="mt-4">
        <Legend title="What the labels mean" groups={NVIDIA_LEGEND} />
      </div>
      <div class="mt-4">
        <StatusTable client:load rows={nvidia} columns={nvidiaColumns} />
      </div>
    </section>

    <p class="mt-8 scroll-mt-6 text-sm text-zinc-400" id="apple">
      Apple Silicon Macs run Omarchy on top of Asahi Linux. <a class={LINK} href="https://asahilinux.org/docs/platform/feature-support/overview/">Asahi's feature support pages</a> track which models and features work.
    </p>

    <section class="mt-12 scroll-mt-6 rounded-xl bg-zinc-900 p-6 text-sm text-zinc-400 ring-1 ring-zinc-800" id="help">
      <h2 class="text-base font-semibold text-zinc-100">Help a model get there</h2>
      <p class="mt-2 max-w-3xl">
        Own one of the models marked <span class={`${PILL} ${TONE.wanted}`}>Wanted</span>, or one that's missing from the list? Tell us its model, its hardware IDs and where its driver download is, and whether you can test boot images on it. An owner who can test is what gets a device tree finished.
      </p>
      <p class="mt-2 max-w-3xl">
        Its ACPI tables and the list of its firmware files need a tool to collect, and one is on its way. Until then, a dump you already have is welcome too.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href={`${REPO}/issues/new?template=model.yml`} class="rounded-md bg-zinc-100 px-3 py-1.5 font-medium text-zinc-900 hover:bg-white">Add your model</a>
        <a href={`${REPO}/blob/main/data/models.yaml`} class="rounded-md px-3 py-1.5 text-zinc-200 ring-1 ring-zinc-700 hover:bg-zinc-800">Edit the model list</a>
      </div>
    </section>

    <section class="mt-12 grid gap-8 text-sm text-zinc-400 sm:grid-cols-2">
      <div>
        <h2 class="text-base font-semibold text-zinc-100">What a model needs</h2>
        <p class="mt-2">
          ARM laptops don't describe their hardware to Linux the way PCs do, so each model needs a <strong class="text-zinc-200">device tree</strong>, written from its ACPI tables. Its <strong class="text-zinc-200">hardware IDs</strong> in systemd let a boot image pick that device tree by itself, and its <strong class="text-zinc-200">firmware</strong> files for the DSPs, GPU and Wi-Fi have to come from linux-firmware or from Windows.
        </p>
      </div>
      <div>
        <h2 class="text-base font-semibold text-zinc-100">Where the data comes from</h2>
        <p class="mt-2">
          Collected {collected} from{' '}
          <a class={LINK} href="https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git/tree/arch/arm64/boot/dts/qcom">Linux</a> and linux-next {status.linuxNext},{' '}
          <a class={LINK} href="https://github.com/systemd/systemd/tree/main/src/boot/hwids/aa64">systemd's hardware IDs</a>,{' '}
          <a class={LINK} href="https://gitlab.com/kernel-firmware/linux-firmware/-/tree/main/qcom">linux-firmware</a>,{' '}
          <a class={LINK} href="https://github.com/aarch64-laptops/build/tree/HEAD/misc">aarch64-laptops</a>{' '}
          and <a class={LINK} href="https://github.com/omacom/omarchy-pkgs">Omarchy's packages</a>.
        </p>
      </div>
    </section>
  </main>
</Layout>
