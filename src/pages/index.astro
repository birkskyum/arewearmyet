---
import Layout from '../layouts/Layout.astro';
import Legend from '../components/Legend.astro';
import Family from '../components/Family.astro';
import StatusTable from '../components/StatusTable';
import OmarchyIcon from '../assets/omarchy-icon.svg';
import status from '../data/status.json';
import { ANNOUNCED, FILTERS, GOOGLEBOOK_LEGEND, LEGEND, NVIDIA_LEGEND, TONE } from '../lib/labels';
import { PILL } from '../lib/tones';
import { googlebookRows, nvidiaRows, snapdragonRows, type TableRow } from '../lib/rows';

const { summary } = status;
const channel = status.omarchy.channel.toUpperCase();
const byName = <T extends { vendor: string; name: string }>(a: T, b: T) => a.vendor.localeCompare(b.vendor) || a.name.localeCompare(b.name);
const rows = snapdragonRows().sort(byName);
// The 8cx Gen 3 machines are the generation before Snapdragon X, so they get their own table and stay out of the totals
const current = rows.filter((row) => row.generation !== '8cx');
const older = rows.filter((row) => row.generation === '8cx');
const googlebooks = googlebookRows().sort(byName);
const nvidia = nvidiaRows().sort((a, b) => a.generation.localeCompare(b.generation) || byName(a, b));

// The first goal for every machine is booting into Omarchy: each family's bar counts its rows by outcome,
// leaving out outcomes none of them has
type Outcome = TableRow['outcome'];
type Part = { label: string; color: string; title: string };
const OUTCOMES: Record<Outcome, Part> = {
  works: { label: 'Boots', color: 'bg-emerald-400', title: 'An owner booted into the Omarchy desktop on the current release.' },
  should: { label: 'Ready to test', color: 'bg-amber-400', title: 'Every piece is in place, but no owner has confirmed it boots yet.' },
  problems: { label: 'Problems', color: 'bg-rose-400', title: `An owner couldn't get to the desktop without a workaround.` },
  notyet: { label: 'Not yet', color: 'bg-zinc-600', title: 'Pieces are still missing.' },
};
const outcomeParts = (rows: TableRow[], changes: Partial<Record<Outcome, Partial<Part>>> = {}) =>
  (Object.keys(OUTCOMES) as Outcome[])
    .map((outcome) => ({ ...OUTCOMES[outcome], ...changes[outcome], value: rows.filter((row) => row.outcome === outcome).length }))
    .filter((part, i) => i === 0 || part.value > 0);
const nvidiaParts = outcomeParts(nvidia, { should: { title: 'Same platform as a model that boots.' }, notyet: { label: 'Not tested', title: 'Nobody has tried it yet.' } });
const upstreamBars = [
  { label: 'Device tree in Linux', value: summary.deviceTree, coming: summary.deviceTreeComing, notNeeded: 0, wanted: 0, total: summary.models, note: 'released or queued in linux-next' },
  { label: 'Hardware IDs in systemd', value: summary.ids, coming: summary.idsComing, notNeeded: 0, wanted: 0, total: summary.models, note: 'so an image picks the device tree by itself' },
  { label: `Firmware without the laptop's Windows`, value: summary.firmware, coming: summary.firmwareComing, notNeeded: 0, wanted: 0, total: summary.models, note: `in linux-firmware's newest release or a known vendor download` },
  { label: 'ACPI dumps collected', value: summary.acpi, coming: 0, notNeeded: summary.models - summary.acpi - summary.acpiWanted, wanted: summary.acpiWanted, total: summary.models, note: 'not needed once a model has a device tree, wanted for each one with none anywhere' },
];

const snapdragonIds = ['omarchy', 'device-tree', 'ids', 'firmware', 'acpi'] as const;
const snapdragonColumns = LEGEND.map((group, i) => ({ id: snapdragonIds[i], header: group.column, question: group.question, options: FILTERS[snapdragonIds[i]] }));
const nvidiaColumns = [
  { id: 'omarchy', header: 'Omarchy', question: NVIDIA_LEGEND[0].question, options: FILTERS.nvidiaOmarchy },
  { id: 'linux', header: 'Linux', question: NVIDIA_LEGEND[1].question, options: FILTERS.nvidiaLinux },
  { id: 'notes', header: 'Notes', question: 'What else to know' },
];
const legendExtra = [
  { label: 'Green', tone: 'good' as const, meaning: 'Done.' },
  { label: 'Amber', tone: 'close' as const, meaning: 'On its way, or partly there.' },
  { label: 'Red', tone: 'wanted' as const, meaning: 'Missing or failing, and where help counts most.' },
  { label: 'Grey', tone: 'muted' as const, meaning: 'Works another way today, or not needed.' },
  ANNOUNCED,
];
const googlebookColumns = GOOGLEBOOK_LEGEND.map((group, i) => ({
  id: ['omarchy', 'device-tree', 'bootloader', 'image'][i],
  header: group.column,
  question: group.question,
  options: [FILTERS.googlebookOmarchy, FILTERS.googlebookDeviceTree, FILTERS.bootloader, FILTERS.linuxImage][i],
}));
const HELP = 'mt-2 max-w-3xl text-sm text-zinc-400';

const collected = new Date(status.collected).toISOString().slice(0, 10);
const LINK = 'underline decoration-zinc-600 underline-offset-2 hover:text-zinc-100 hover:decoration-zinc-300';
const REPO = 'https://github.com/birkskyum/arewearmyet';
const NAV = 'rounded-full px-3 py-1 text-zinc-300 ring-1 ring-zinc-700 hover:bg-zinc-800 hover:text-zinc-100';
---

<Layout title="Are we ARM yet?" description="Omarchy on ARM PCs, model by model: which ones boot into it today, and what each one still needs upstream.">
  <main class="mx-auto max-w-[96rem] px-4 py-10 sm:px-6 lg:px-8">
    <header>
      <div class="flex items-center gap-4">
        <a href="https://omarchy.org" title="Omarchy" class="shrink-0 text-[#9ece6a] hover:brightness-110">
          <OmarchyIcon class="h-11 w-11 sm:h-14 sm:w-14" aria-label="Omarchy" />
        </a>
        <h1 class="text-4xl font-bold tracking-tight text-zinc-50 sm:text-5xl">Are we ARM yet?</h1>
      </div>
      <p class="mt-3 text-lg text-zinc-400">Omarchy on ARM PCs, model by model.</p>
      <nav class="mt-5 flex flex-wrap gap-2 text-sm">
        <a href="#snapdragon" class={NAV}>Snapdragon X and X2 <span class="text-zinc-500">{current.length}</span></a>
        <a href="#snapdragon-8cx" class={NAV}>Snapdragon 8cx Gen 3 <span class="text-zinc-500">{older.length}</span></a>
        <a href="#googlebooks" class={NAV}>Googlebooks <span class="text-zinc-500">{googlebooks.length}</span></a>
        <a href="#nvidia" class={NAV}>NVIDIA N1x and GB10 <span class="text-zinc-500">{nvidia.length}</span></a>
        <a href="#apple" class={NAV}>Apple Silicon</a>
      </nav>
      <p class="mt-5 max-w-3xl text-sm text-zinc-400">
        Boots means an owner reached the desktop on Omarchy {channel}, which ships linux-omarchy {status.omarchy.kernel} and systemd {status.omarchy.systemd}. Booting is the first goal; features like suspend and USB4 come next.
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 rounded-xl bg-[#9ece6a]/10 px-5 py-4 ring-1 ring-[#9ece6a]/40">
        <p class="text-zinc-300"><strong class="font-semibold text-[#9ece6a]">Own an ARM laptop that isn't green yet?</strong> A few minutes of yours can get it to Omarchy.</p>
        <a href="/help" class="shrink-0 rounded-md bg-[#9ece6a] px-4 py-2 text-sm font-semibold text-zinc-950 hover:brightness-110">How to help</a>
      </div>
    </header>

    <Family id="snapdragon" title="Snapdragon X and X2" parts={outcomeParts(current)} total={current.length}>
      <p class="max-w-3xl text-sm text-zinc-400">
        To help a model along, send a hardware report from Windows, the device tree you boot with on Linux, or a boot test, as <a class={LINK} href="/help">Help a model get there</a> explains.
      </p>
      <h3 class="mt-6 text-sm font-semibold text-zinc-200">What the models have upstream</h3>
      <dl class="mt-3 space-y-4">
        {upstreamBars.map((bar) => (
          <div>
            <div class="flex items-baseline justify-between gap-4 text-sm">
              <dt class="text-zinc-200">{bar.label} <span class="text-zinc-500">{bar.note}</span></dt>
              <dd class="shrink-0 tabular-nums text-zinc-300">{bar.coming > 0 && <span class="text-zinc-500">{bar.coming} on its way · </span>}{bar.notNeeded > 0 && <span class="text-zinc-500">{bar.notNeeded} not needed · </span>}{bar.wanted > 0 && <span class="text-zinc-500">{bar.wanted} still wanted · </span>}{bar.value} / {bar.total}</dd>
            </div>
            <div class="mt-1.5 flex h-2 overflow-hidden rounded-full bg-zinc-800">
              <div class="h-full bg-emerald-400" style={`width: ${(100 * bar.value) / Math.max(bar.total, 1)}%`} data-tip-title={`Done: ${bar.value}`} data-tip={bar.label}></div>
              <div class="h-full bg-amber-400" style={`width: ${(100 * bar.coming) / Math.max(bar.total, 1)}%`} data-tip-title={`On its way: ${bar.coming}`} data-tip={bar.label}></div>
              <div class="h-full bg-zinc-600" style={`width: ${(100 * bar.notNeeded) / Math.max(bar.total, 1)}%`} data-tip-title={`Not needed: ${bar.notNeeded}`} data-tip={bar.label}></div>
            </div>
          </div>
        ))}
      </dl>
      <div class="mt-8">
        <Legend title="What the labels mean" groups={LEGEND} extra={legendExtra} />
      </div>
      <div class="mt-4">
        <StatusTable
          client:load
          rows={current}
          columns={snapdragonColumns}
          chips={[{ key: 'x1', label: 'Snapdragon X' }, { key: 'x2', label: 'Snapdragon X2' }]}
          urlPrefix=""
        />
      </div>
    </Family>

    <Family id="snapdragon-8cx" title="Snapdragon 8cx Gen 3" parts={outcomeParts(older)} total={older.length}>
      <p class="max-w-3xl text-sm text-zinc-400">
        The generation before Snapdragon X. They need the same pieces and use the same labels as the models above.
      </p>
      <div class="mt-4">
        <StatusTable client:load rows={older} columns={snapdragonColumns} chips={[]} urlPrefix="8cx-" />
      </div>
    </Family>

    <Family id="googlebooks" title="Googlebooks with Snapdragon" parts={outcomeParts(googlebooks)} total={googlebooks.length}>
      <p class="max-w-3xl text-sm text-zinc-400">
        They use the same Snapdragon X Elite as the laptops above, but start like a Pixel, through Android's bootloader instead of UEFI. So they need no ACPI tables or hardware IDs, and Omarchy's ARM image doesn't start on them; they need a device tree and a Linux image built for that bootloader.
      </p>
      <p class={HELP}>
        To help, read the device tree Googlebook OS starts with, following the <a class={LINK} href="https://github.com/omacom/omarchy/discussions/16627">owner guide</a>. It changes nothing on the laptop.
      </p>
      <div class="mt-4">
        <Legend title="What the labels mean" groups={GOOGLEBOOK_LEGEND} />
      </div>
      <div class="mt-4">
        <StatusTable client:load rows={googlebooks} columns={googlebookColumns} chips={[{ key: 'x1', label: 'Snapdragon X' }, { key: 'x2', label: 'Snapdragon X2' }]} urlPrefix="googlebook-" />
      </div>
    </Family>

    <Family id="nvidia" title="NVIDIA N1x and GB10" parts={nvidiaParts} total={nvidia.length}>
      <p class="max-w-3xl text-sm text-zinc-400">
        NVIDIA's ARM laptops and desktops start through ACPI, so they need no device tree or hardware IDs. What counts here is whether someone has booted into Omarchy on them.
      </p>
      <p class={HELP}>
        To help, install from Omarchy's ARM image and report whether it boots, through <a class={LINK} href={`${REPO}/issues/new?template=model.yml`}>Add your model</a>.
      </p>
      <div class="mt-4">
        <Legend title="What the labels mean" groups={NVIDIA_LEGEND} />
      </div>
      <div class="mt-4">
        <StatusTable client:load rows={nvidia} columns={nvidiaColumns} chips={[{ key: 'n1x', label: 'NVIDIA N1x' }, { key: 'gb10', label: 'NVIDIA GB10' }]} urlPrefix="nvidia-" />
      </div>
    </Family>

    <p class="mt-8 scroll-mt-6 text-sm text-zinc-400" id="apple">
      Apple Silicon Macs run Omarchy on top of Asahi Linux. <a class={LINK} href="https://asahilinux.org/docs/platform/feature-support/overview/">Asahi's feature support pages</a> track which models and features work.
    </p>

    <section class="mt-12 grid gap-8 text-sm text-zinc-400 sm:grid-cols-2">
      <div>
        <h2 class="text-base font-semibold text-zinc-100">What a model needs</h2>
        <p class="mt-2">
          ARM laptops don't describe their hardware to Linux the way PCs do, so each model needs a <strong class="text-zinc-200">device tree</strong>, written from its ACPI tables. Its <strong class="text-zinc-200">hardware IDs</strong> in systemd let a boot image pick that device tree by itself, and its <strong class="text-zinc-200">firmware</strong> files for the DSPs, GPU and Wi-Fi have to come from linux-firmware or from Windows.
        </p>
      </div>
      <div>
        <h2 class="text-base font-semibold text-zinc-100">Where the data comes from</h2>
        <p class="mt-2">
          Collected {collected} from{' '}
          <a class={LINK} href="https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git/tree/arch/arm64/boot/dts/qcom">Linux</a> and linux-next {status.linuxNext},{' '}
          <a class={LINK} href="https://github.com/systemd/systemd/tree/main/src/boot/hwids/aa64">systemd's hardware IDs</a>,{' '}
          <a class={LINK} href="https://gitlab.com/kernel-firmware/linux-firmware/-/tree/main/qcom">linux-firmware</a>,{' '}
          <a class={LINK} href="https://github.com/aarch64-laptops/build/tree/HEAD/misc">aarch64-laptops</a>{' '}
          and <a class={LINK} href="https://github.com/omacom/omarchy-pkgs">Omarchy's packages</a>.
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <a href={`${REPO}/issues/new?template=model.yml`} class="rounded-md px-3 py-1.5 text-zinc-200 ring-1 ring-zinc-700 hover:bg-zinc-800">Add your model</a>
          <a href={`${REPO}/blob/main/data/models.yaml`} class="rounded-md px-3 py-1.5 text-zinc-200 ring-1 ring-zinc-700 hover:bg-zinc-800">Edit the model list</a>
        </div>
      </div>
    </section>
  </main>
</Layout>
