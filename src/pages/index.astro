---
import Layout from '../layouts/Layout.astro';
import Legend from '../components/Legend.astro';
import Family from '../components/Family.astro';
import StatusTable from '../components/StatusTable';
import ChipIcon from '../assets/chip-icon.svg';
import OmarchyIcon from '../assets/omarchy-icon.svg';
import GitHubIcon from '../assets/github-icon.svg';
import status from '../data/status.json';
import { ANNOUNCED, FILTERS, GOOGLEBOOK_OMARCHY_LEGEND, GOOGLEBOOK_UPSTREAM_LEGEND, NVIDIA_OMARCHY_LEGEND, NVIDIA_UPSTREAM_LEGEND, OMARCHY_LEGEND, TONE, UPSTREAM_LEGEND } from '../lib/labels';
import { PILL } from '../lib/tones';
import { googlebookRows, nvidiaRows, snapdragonRows } from '../lib/rows';

const { summary } = status;
// The edge nightly image testers install, linked as the collector last found it
const image = status.omarchy.image;
const byName = <T extends { vendor: string; name: string }>(a: T, b: T) => a.vendor.localeCompare(b.vendor) || a.name.localeCompare(b.name);
const rows = snapdragonRows().sort(byName);
// The 8cx Gen 3 machines are the generation before Snapdragon X and Snapdragon C is the entry line beside it, so
// both get their own table and stay out of the totals
const current = rows.filter((row) => row.generation !== '8cx' && row.generation !== 'c');
const older = rows.filter((row) => row.generation === '8cx');
const entry = rows.filter((row) => row.generation === 'c');
const googlebooks = googlebookRows().sort(byName);
const nvidia = nvidiaRows().sort((a, b) => a.generation.localeCompare(b.generation) || byName(a, b));

// Where each piece stands: in any Omarchy channel, in the releases every distro gets,
// in an open omarchy-pkgs pull request or elsewhere
const { byPiece } = summary;
const channelNote = (channels: Record<string, number>) => `Stable ${channels.stable}, RC ${channels.rc}, edge ${channels.edge}.`;
const pieceRows = [
  { label: 'Device tree', ...byPiece.deviceTree, ours: `Trees Omarchy's kernel adds. ${channelNote(byPiece.deviceTree.channels)}`, theirs: 'In a Linux release.', none: 'Nobody has written its tree yet.' },
  { label: 'Hardware IDs', ...byPiece.ids, ours: `IDs Omarchy's kernel adds, or systemd's that only Omarchy's systemd has. ${channelNote(byPiece.ids.channels)}`, theirs: 'In a systemd release.', none: 'Nobody has sent its hardware IDs yet.' },
  { label: 'Firmware', ...byPiece.firmware, ours: `Firmware Omarchy packages. ${channelNote(byPiece.firmware.channels)}`, theirs: 'Every file in a linux-firmware release.', none: 'Its firmware has only turned up in Windows so far.' },
  { label: 'All three', ...byPiece.all, ours: 'Device tree, hardware IDs and firmware, all in Omarchy, where upstream lacks at least one.', theirs: 'All three in the releases.', none: `At least one piece doesn't exist yet.` },
];
// One cell per model, in the bar's order and by name within each part, each linking to its model in the table
const modelById = new Map(current.map((model) => [model.id, model]));
const cells = (row: (typeof pieceRows)[number]) => {
  const parts = [
    { ids: row.models.fromUpstream, color: 'bg-sky-400', tip: `${row.theirs} Omarchy ships it too.` },
    { ids: row.models.added, color: 'bg-emerald-400', tip: 'Only Omarchy ships it so far.' },
    { ids: row.models.pull, color: 'bg-amber-400', tip: 'An open pull request on omarchy-pkgs adds it.' },
    { ids: row.models.available, color: 'bg-zinc-600', tip: `It exists elsewhere, but Omarchy doesn't carry it yet.` },
  ];
  const placed = new Set(parts.flatMap((part) => part.ids));
  parts.push({ ids: current.filter((model) => !placed.has(model.id)).map((model) => model.id), color: 'bg-zinc-800', tip: row.none });
  return parts.flatMap((part) => part.ids.map((id) => modelById.get(id)!).sort(byName).map((model) => ({ name: `${model.vendor} ${model.name}`, color: part.color, tip: part.tip })));
};
// Whether it boots first, then the pieces in the order a model gets them
const omarchyIds = ['bootable', 'acpi', 'tree', 'hwids', 'fw', 'machine'] as const;
const upstreamIds = ['device-tree', 'ids', 'firmware'] as const;
const snapdragonViews = [
  { id: 'omarchy', label: 'Omarchy', question: `What Omarchy's packages ship today, by the most stable channel that has it.`, columns: OMARCHY_LEGEND.map((group, i) => ({ id: omarchyIds[i], header: group.column, question: group.question, options: FILTERS[omarchyIds[i]] })) },
  { id: 'upstream', label: 'Upstream', question: 'What Linux, systemd and linux-firmware have, which every distro gets.', columns: UPSTREAM_LEGEND.map((group, i) => ({ id: upstreamIds[i], header: group.column, question: group.question, options: FILTERS[upstreamIds[i]] })) },
];
const nvidiaNotes = { id: 'notes', header: 'Notes', question: 'What else to know' };
const nvidiaViews = [
  { id: 'omarchy', label: 'Omarchy', question: `What Omarchy's kernel ships today, by the most stable channel that has it.`, columns: [
    { id: 'kernel', header: 'Kernel', question: NVIDIA_OMARCHY_LEGEND[0].question, options: FILTERS.nvidiaKernel },
    { id: 'omarchy', header: NVIDIA_OMARCHY_LEGEND[1].column, question: NVIDIA_OMARCHY_LEGEND[1].question, options: FILTERS.nvidiaOmarchy },
    nvidiaNotes,
  ] },
  { id: 'upstream', label: 'Upstream', question: 'What Linux itself has, which every distro gets.', columns: [
    { id: 'linux', header: 'Linux', question: NVIDIA_UPSTREAM_LEGEND[0].question, options: FILTERS.nvidiaLinux },
    nvidiaNotes,
  ] },
];
const legendExtra = [
  { label: 'Green', tone: 'good' as const, meaning: 'Done.' },
  { label: 'Amber', tone: 'close' as const, meaning: 'On its way, or partly there.' },
  { label: 'Red', tone: 'wanted' as const, meaning: 'Missing or failing, and where help counts most.' },
  { label: 'Grey', tone: 'muted' as const, meaning: 'Works another way today, or not needed.' },
  ANNOUNCED,
];
const googlebookViews = [
  { id: 'omarchy', label: 'Omarchy', question: `What Omarchy's packages ship for it today, and what owners reached.`, columns: GOOGLEBOOK_OMARCHY_LEGEND.map((group, i) => ({
    id: ['bootloader', 'tree', 'image', 'omarchy'][i],
    header: group.column,
    question: group.question,
    options: [FILTERS.bootloader, FILTERS.tree, FILTERS.linuxImage, FILTERS.googlebookOmarchy][i],
  })) },
  { id: 'upstream', label: 'Upstream', question: 'What Linux itself has, which every distro gets.', columns: [
    { id: 'device-tree', header: 'Linux', question: GOOGLEBOOK_UPSTREAM_LEGEND[0].question, options: FILTERS.googlebookDeviceTree },
  ] },
];
const HELP = 'mt-2 max-w-3xl text-sm text-zinc-400';

const collected = new Date(status.collected).toISOString().slice(0, 10);
const LINK = 'underline decoration-zinc-600 underline-offset-2 hover:text-zinc-100 hover:decoration-zinc-300';
const REPO = 'https://github.com/birkskyum/arewearmyet';
const NAV = 'rounded-full px-3 py-1 text-zinc-300 ring-1 ring-zinc-700 hover:bg-zinc-800 hover:text-zinc-100';
---

<Layout title="Are we ARM yet? Omarchy on ARM PCs, model by model" description="Which ARM PCs boot Omarchy today, what Omarchy ships for each, and what Linux, systemd and linux-firmware have.">
  <main class="mx-auto max-w-[96rem] px-4 py-10 sm:px-6 lg:px-8">
    <header>
      <div class="flex items-start justify-between gap-4">
        <div class="flex items-center gap-4">
          <ChipIcon class="h-11 w-11 shrink-0 text-[#9ece6a] sm:h-14 sm:w-14" aria-hidden="true" />
          <h1 class="text-4xl font-bold tracking-tight text-zinc-50 sm:text-5xl">Are we ARM yet?</h1>
        </div>
        <a href={REPO} class="flex shrink-0 items-center gap-2 rounded-md p-2 text-sm text-zinc-300 ring-1 ring-zinc-700 hover:bg-zinc-800 hover:text-zinc-100 sm:px-3 sm:py-1.5" aria-label="Are we ARM yet? on GitHub">
          <GitHubIcon class="h-5 w-5" aria-hidden="true" />
          <span class="hidden sm:inline">GitHub</span>
        </a>
      </div>
      <p class="mt-3 text-lg text-zinc-400">Omarchy on ARM PCs, model by model.</p>
      <nav class="mt-5 flex flex-wrap gap-2 text-sm">
        <a href="#snapdragon" class={NAV}>Snapdragon X and X2 <span class="text-zinc-500">{current.length}</span></a>
        <a href="#snapdragon-8cx" class={NAV}>Snapdragon 8cx Gen 3 <span class="text-zinc-500">{older.length}</span></a>
        <a href="#snapdragon-c" class={NAV}>Snapdragon C <span class="text-zinc-500">{entry.length}</span></a>
        <a href="#googlebooks" class={NAV}>Googlebooks <span class="text-zinc-500">{googlebooks.length}</span></a>
        <a href="#nvidia" class={NAV}>NVIDIA N1x and GB10 <span class="text-zinc-500">{nvidia.length}</span></a>
        <a href="#apple" class={NAV}>Apple Silicon</a>
      </nav>
      <p class="mt-5 max-w-3xl text-sm text-zinc-400">
        Every ARM laptop needs a device tree, hardware IDs and firmware. Omarchy ships them in its own packages, often before Linux, systemd and linux-firmware have them. The Omarchy view shows what its channels ship today, and the Upstream view what every distro gets. Bootable names the most stable channel whose install image picks the model's device tree by itself. Edge is the {image ? <a class={LINK} href={image.url}>nightly image</a> : 'nightly image'}, with <span class="whitespace-nowrap">linux-omarchy {status.omarchy.kernel}</span> and systemd {status.omarchy.systemd}. Booting is the first goal; features like suspend and USB4 come next.
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 rounded-xl bg-[#9ece6a]/10 px-5 py-4 ring-1 ring-[#9ece6a]/40">
        <p class="text-zinc-300"><strong class="font-semibold text-[#9ece6a]">Own an ARM laptop that isn't green yet?</strong> Help get it there, whatever distro you run. It only takes a few minutes.</p>
        <a href="/help" class="shrink-0 rounded-md bg-[#9ece6a] px-4 py-2 text-sm font-semibold text-zinc-950 hover:brightness-110">How to help</a>
      </div>
    </header>

    <Family id="snapdragon" title="Snapdragon X and X2" total={current.length}>
      <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2">
        <h3 class="text-sm font-semibold text-zinc-200">Omarchy and upstream</h3>
        <ul class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-zinc-400">
          <li class="flex items-center gap-1.5"><span class="size-2.5 rounded-[2px] bg-sky-400"></span>Upstream releases</li>
          <li class="flex items-center gap-1.5"><span class="size-2.5 rounded-[2px] bg-emerald-400"></span>Omarchy adds</li>
          <li class="flex items-center gap-1.5"><span class="size-2.5 rounded-[2px] bg-amber-400"></span><a class={LINK} href="https://github.com/omacom/omarchy-pkgs/pulls">Open pull requests</a></li>
          <li class="flex items-center gap-1.5"><span class="size-2.5 rounded-[2px] bg-zinc-600"></span>Exists elsewhere</li>
        </ul>
      </div>
      <dl class="mt-4 grid gap-x-8 gap-y-5 sm:grid-cols-2">
        {pieceRows.map((row) => (
          <div>
            <dt class="text-sm font-medium text-zinc-200">{row.label}</dt>
            <dd class="mt-2 flex items-center gap-3 text-xs">
              <div class="@container min-w-0 flex-1">
                <div class="grid h-3 grid-flow-col grid-cols-[repeat(var(--half),minmax(0,1fr))] grid-rows-2 gap-0.5 @lg:grid-flow-row @lg:grid-cols-[repeat(var(--all),minmax(0,1fr))] @lg:grid-rows-1" style={`--all: ${summary.models}; --half: ${Math.ceil(summary.models / 2)}`}>
                  {cells(row).map((cell) => (
                    <a href={`/?q=${encodeURIComponent(cell.name)}#snapdragon`} class={`rounded-[2px] ${cell.color} transition hover:scale-y-150 hover:brightness-150`} data-tip-title={cell.name} data-tip={cell.tip} aria-label={`${cell.name}: ${cell.tip}`}></a>
                  ))}
                </div>
              </div>
              <span class="w-28 shrink-0 whitespace-nowrap tabular-nums text-zinc-300" data-tip-title={`Omarchy: ${row.omarchy} of ${summary.models}`} data-tip={row.ours}>{row.omarchy}{row.pull > 0 && <span class="text-amber-300"> +{row.pull}</span>}{row.available > 0 && <span class="text-zinc-500"> +{row.available}</span>} <span class="text-zinc-500">/ {summary.models}</span></span>
            </dd>
          </div>
        ))}
      </dl>
      <div class="group/views mt-8" data-views data-view="omarchy">
        <div class="group-data-[view=upstream]/views:hidden">
          <Legend title="What the labels mean" groups={OMARCHY_LEGEND} extra={legendExtra} />
        </div>
        <div class="hidden group-data-[view=upstream]/views:block">
          <Legend title="What the labels mean" groups={UPSTREAM_LEGEND} extra={legendExtra} />
        </div>
        <div class="mt-4">
          <StatusTable
            client:load
            rows={current}
            views={snapdragonViews}
            chips={[{ key: 'x1', label: 'Snapdragon X' }, { key: 'x2', label: 'Snapdragon X2' }]}
            urlPrefix=""
            exportName="arewearmyet-snapdragon-x"
            exportTitle="Snapdragon X and X2"
          />
        </div>
      </div>
    </Family>

    <Family id="snapdragon-8cx" title="Snapdragon 8cx Gen 3" total={older.length}>
      <p class="max-w-3xl text-sm text-zinc-400">
        The generation before Snapdragon X. They need the same pieces and use the same views and labels as the models above.
      </p>
      <div class="mt-4">
        <StatusTable client:load rows={older} views={snapdragonViews} chips={[]} urlPrefix="8cx-" exportName="arewearmyet-snapdragon-8cx" exportTitle="Snapdragon 8cx Gen 3" />
      </div>
    </Family>

    <Family id="snapdragon-c" title="Snapdragon C" total={entry.length}>
      <p class="max-w-3xl text-sm text-zinc-400">
        Qualcomm's entry line for budget Windows laptops. Its drivers are the ones for the 7c Gen 3 (SC7280) in Arm Chromebooks, a chip Linux already describes, so each laptop needs a board tree, hardware IDs and firmware like the models above.
      </p>
      <div class="mt-4">
        <StatusTable client:load rows={entry} views={snapdragonViews} chips={[]} urlPrefix="c-" exportName="arewearmyet-snapdragon-c" exportTitle="Snapdragon C" />
      </div>
    </Family>

    <Family id="googlebooks" title="Googlebooks with Snapdragon" total={googlebooks.length}>
      <p class="max-w-3xl text-sm text-zinc-400">
        They use the same Snapdragon X Elite as the laptops above, but start like a Pixel, through Android's bootloader instead of UEFI. So they need no ACPI tables or hardware IDs, and Omarchy's ARM image doesn't start on them; they need a device tree and a Linux image built for that bootloader.
      </p>
      <p class={HELP}>
        To help, read the device tree Googlebook OS starts with, following the <a class={LINK} href="https://github.com/omacom/omarchy/discussions/16627">owner guide</a>. It changes nothing on the laptop.
      </p>
      <div class="group/views mt-4" data-views data-view="omarchy">
        <div class="group-data-[view=upstream]/views:hidden">
          <Legend title="What the labels mean" groups={GOOGLEBOOK_OMARCHY_LEGEND} />
        </div>
        <div class="hidden group-data-[view=upstream]/views:block">
          <Legend title="What the labels mean" groups={GOOGLEBOOK_UPSTREAM_LEGEND} />
        </div>
        <div class="mt-4">
          <StatusTable client:load rows={googlebooks} views={googlebookViews} chips={[{ key: 'x1', label: 'Snapdragon X' }, { key: 'x2', label: 'Snapdragon X2' }]} urlPrefix="googlebook-" exportName="arewearmyet-googlebooks" exportTitle="Googlebooks with Snapdragon" />
        </div>
      </div>
    </Family>

    <Family id="nvidia" title="NVIDIA N1x and GB10" total={nvidia.length}>
      <p class="max-w-3xl text-sm text-zinc-400">
        NVIDIA's ARM laptops and desktops start through ACPI, so they need no device tree or hardware IDs. Omarchy's kernel carries the patches they need, which Linux itself doesn't have yet, so what counts here is whether someone has booted into Omarchy on them.
      </p>
      <p class={HELP}>
        To help, install Omarchy's ARM image or another distro and report whether it boots, through <a class={LINK} href={`${REPO}/issues/new?template=model.yml`}>Add your model</a>.
      </p>
      <div class="group/views mt-4" data-views data-view="omarchy">
        <div class="group-data-[view=upstream]/views:hidden">
          <Legend title="What the labels mean" groups={NVIDIA_OMARCHY_LEGEND} />
        </div>
        <div class="hidden group-data-[view=upstream]/views:block">
          <Legend title="What the labels mean" groups={NVIDIA_UPSTREAM_LEGEND} />
        </div>
        <div class="mt-4">
          <StatusTable client:load rows={nvidia} views={nvidiaViews} chips={[{ key: 'n1x', label: 'NVIDIA N1x' }, { key: 'gb10', label: 'NVIDIA GB10' }]} urlPrefix="nvidia-" exportName="arewearmyet-nvidia" exportTitle="NVIDIA N1x and GB10" />
        </div>
      </div>
    </Family>

    <p class="mt-8 scroll-mt-6 text-sm text-zinc-400" id="apple">
      Apple Silicon Macs run Linux through Asahi Linux, which Omarchy builds on. <a class={LINK} href="https://asahilinux.org/docs/platform/feature-support/overview/">Asahi's feature support pages</a> track which models and features work.
    </p>

    <section class="mt-12 grid gap-8 text-sm text-zinc-400 sm:grid-cols-2">
      <div>
        <h2 class="text-base font-semibold text-zinc-100">What a model needs</h2>
        <p class="mt-2">
          ARM laptops don't describe their hardware to Linux the way PCs do, so each model needs a <strong class="text-zinc-200">device tree</strong>, written from its ACPI tables. Its <strong class="text-zinc-200">hardware IDs</strong> in systemd let a boot image pick that device tree by itself, and its <strong class="text-zinc-200">firmware</strong> files for the DSPs, GPU and Wi-Fi have to come from linux-firmware, from Windows, or from <a class={LINK} href="/firmware">the maker's own download</a>.
        </p>
      </div>
      <div>
        <h2 class="text-base font-semibold text-zinc-100">Where the data comes from</h2>
        <p class="mt-2">
          Collected {collected} from{' '}
          <a class={LINK} href="https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git/tree/arch/arm64/boot/dts/qcom">Linux</a> and linux-next {status.linuxNext},{' '}
          <a class={LINK} href="https://github.com/systemd/systemd/tree/main/src/boot/hwids/aa64">systemd's hardware IDs</a>,{' '}
          <a class={LINK} href="https://gitlab.com/kernel-firmware/linux-firmware/-/tree/main/qcom">linux-firmware</a>,{' '}
          <a class={LINK} href="https://github.com/aarch64-laptops/build/tree/HEAD/misc">aarch64-laptops</a>,{' '}
          <a class={LINK} href="https://github.com/turbineBMW/omarchy-hardware-reports">owners' hardware reports</a>{' '}
          and <a class={LINK} href="https://github.com/omacom/omarchy-pkgs">Omarchy's packages</a>.
        </p>
        <p class="mt-2">Made by the <a class={`${LINK} whitespace-nowrap`} href="https://omarchy.org"><OmarchyIcon class="mr-1 inline h-3.5 w-3.5 align-[-2px] text-[#9ece6a]" aria-hidden="true" />Omarchy</a> team. The code and data are <a class={LINK} href={REPO}>on GitHub</a>.</p>
        <div class="mt-4 flex flex-wrap gap-3">
          <a href={`${REPO}/issues/new?template=model.yml`} class="rounded-md px-3 py-1.5 text-zinc-200 ring-1 ring-zinc-700 hover:bg-zinc-800">Add your model</a>
          <a href={`${REPO}/blob/main/data/models.yaml`} class="rounded-md px-3 py-1.5 text-zinc-200 ring-1 ring-zinc-700 hover:bg-zinc-800">Edit the model list</a>
        </div>
      </div>
    </section>
  </main>
</Layout>
