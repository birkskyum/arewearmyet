---
import Layout from '../layouts/Layout.astro';
import Legend from '../components/Legend.astro';
import Family from '../components/Family.astro';
import Progress from '../components/Progress';
import StatusTable from '../components/StatusTable';
import OmarchyIcon from '../assets/omarchy-icon.svg';
import status from '../data/status.json';
import { ANNOUNCED, CHROMEBOOK_OMARCHY_LEGEND, FILTERS, GOOGLEBOOK_OMARCHY_LEGEND, GOOGLEBOOK_UPSTREAM_LEGEND, NVIDIA_OMARCHY_LEGEND, NVIDIA_UPSTREAM_LEGEND, OMARCHY_LEGEND, TONE, UPSTREAM_LEGEND } from '../lib/labels';
import { PILL } from '../lib/tones';
import { googlebookRows, nvidiaRows, snapdragonRows } from '../lib/rows';
import { PARTS, PART_OPTIONS } from '../lib/parts';
import ChipPills from '../components/ChipPills';
import { PROGRESS_GROUPS, PROGRESS_PARTS, progressCounts, progressModels } from '../lib/progress';
import Group from '../components/Group.astro';
import ViewState from '../components/ViewState.astro';
import ModeSwitch from '../components/ModeSwitch.astro';

// The edge nightly image testers install, linked as the collector last found it
const image = status.omarchy.image;
const byName = <T extends { vendor: string; name: string }>(a: T, b: T) => a.vendor.localeCompare(b.vendor) || a.name.localeCompare(b.name);
const rows = snapdragonRows().sort(byName);
// The Snapdragon 7c, 8cx, 835 and 850 machines are the Windows on Arm PCs from before Snapdragon X, and Snapdragon C is the entry line beside
// it, so both get their own table and stay out of the totals
const OLDER = ['8cx', '8cx-gen1', '850', '835', '7c'];
const current = rows.filter((row) => row.generation === 'x1' || row.generation === 'x2');
const older = rows.filter((row) => OLDER.includes(row.generation));
const entry = rows.filter((row) => row.generation === 'c');
const googlebooks = googlebookRows().sort(byName);
const chromebooks = googlebookRows('depthcharge').sort(byName);
const nvidia = nvidiaRows().sort((a, b) => a.generation.localeCompare(b.generation) || byName(a, b));

// Whether it boots first, then the pieces in the order a model gets them
const omarchyIds = ['bootable', 'acpi', 'tree', 'hwids', 'fw', 'machine'] as const;
const upstreamIds = ['device-tree', 'ids', 'firmware'] as const;
// The hardware view's legend, with the marks once, then what each column covers
const HARDWARE_LEGEND = [
  { column: 'Seen on Omarchy', question: 'A filled label is a result from Omarchy itself, measured by hw-test or reported by an owner. Only these count as the model\'s status.', states: [
    { label: 'Works', tone: 'good' as const, meaning: 'Every check of the part that has a result works.' },
    { label: 'Partly', tone: 'close' as const, meaning: 'Some of it works, or it works with a fault.' },
    { label: 'Broken', tone: 'wanted' as const, meaning: 'None of what was checked works.' },
    { label: 'Works 2/6', tone: 'good' as const, meaning: 'The count says how many of the part\'s checks have a result. The rest are still open.' },
  ] },
  { column: 'Not tested', question: 'Nobody has reported on the part yet. Running hw-test on the model fills it in. A dash means the model does not have the part.', states: [] },
  ...PARTS.map((part) => ({ column: part.title, question: part.question, states: [] })),
];
const HARDWARE_QUESTION = 'Whether it boots, and what works once it runs, part by part. Every part\'s label is a result from Omarchy on that model, by hw-test or an owner.';
// The table opens with the models most was seen of on top. That count orders the rows and is no column,
// since the parts beside it say the same
const HARDWARE_VIEW = { id: 'hardware', label: 'What works', question: HARDWARE_QUESTION, sort: 'seen', compact: true,
  hidden: [{ id: 'seen', header: 'Seen on Omarchy', question: 'How many of the parts have a result from Omarchy, by hw-test or an owner.' }],
  columns: PARTS.map((part) => ({ id: `part-${part.id}`, header: part.title, question: part.question, options: PART_OPTIONS })),
};
// A visitor asks whether a model boots before anything else, so the Hardware view opens with the family's
// own Bootable column, and its legend with that column's labels
type BootColumn = { id: string; header: string; question: string; options?: unknown };
type LegendGroup = (typeof OMARCHY_LEGEND)[number];
const hardwareView = (boot: BootColumn) => ({ ...HARDWARE_VIEW, columns: [boot, ...HARDWARE_VIEW.columns] });
const hardwareLegend = (boot: LegendGroup) => [boot, ...HARDWARE_LEGEND];
const HARDWARE_KEYS = [{ dot: 'bg-emerald-400', text: 'works' }, { dot: 'bg-amber-400', text: 'partly' }, { dot: 'bg-rose-400', text: 'broken' }];
const HARDWARE_DOTS = { id: 'parts', header: 'Parts', question: `The parts past booting, in the order of What works (${PARTS.map((part) => part.title.toLowerCase()).join(', ')}). Filled is seen on Omarchy on that model, faint is not tested yet. Click for What works.` };
const snapdragonViews = [
  { id: 'omarchy', label: 'Omarchy', question: `What Omarchy's packages ship today. A check is a piece Omarchy ships, and pointing at it says which channel has it.`, columns: [...OMARCHY_LEGEND.map((group, i) => ({ id: omarchyIds[i], header: group.column, question: group.question, options: FILTERS[omarchyIds[i]] })), HARDWARE_DOTS] },
  { id: 'upstream', label: 'Upstream', question: 'What Linux, systemd and linux-firmware have, which every distro gets.', columns: UPSTREAM_LEGEND.map((group, i) => ({ id: upstreamIds[i], header: group.column, question: group.question, options: FILTERS[upstreamIds[i]] })) },
  hardwareView({ id: omarchyIds[0], header: OMARCHY_LEGEND[0].column, question: OMARCHY_LEGEND[0].question, options: FILTERS[omarchyIds[0]] }),
];
const nvidiaNotes = { id: 'notes', header: 'Notes', question: 'What else to know' };
const nvidiaViews = [
  { id: 'omarchy', label: 'Omarchy', question: `What Omarchy's kernel ships today. A check means it carries the patches, and pointing at it says which channel has them.`, columns: [
    { id: 'kernel', header: 'Kernel', question: NVIDIA_OMARCHY_LEGEND[0].question, options: FILTERS.nvidiaKernel },
    { id: 'omarchy', header: NVIDIA_OMARCHY_LEGEND[1].column, question: NVIDIA_OMARCHY_LEGEND[1].question, options: FILTERS.nvidiaOmarchy },
    nvidiaNotes,
    HARDWARE_DOTS,
  ] },
  { id: 'upstream', label: 'Upstream', question: 'What Linux itself has, which every distro gets.', columns: [
    { id: 'linux', header: 'Linux', question: NVIDIA_UPSTREAM_LEGEND[0].question, options: FILTERS.nvidiaLinux },
    nvidiaNotes,
  ] },
  hardwareView({ id: 'omarchy', header: NVIDIA_OMARCHY_LEGEND[1].column, question: NVIDIA_OMARCHY_LEGEND[1].question, options: FILTERS.nvidiaOmarchy }),
];
const legendExtra = [
  { label: 'Green', tone: 'good' as const, meaning: 'Done.' },
  { label: 'Amber', tone: 'close' as const, meaning: 'On its way, or partly there.' },
  { label: 'Red', tone: 'wanted' as const, meaning: 'Missing or failing, and where help counts most.' },
  { label: 'Grey', tone: 'muted' as const, meaning: 'Works another way today, or not needed.' },
  { label: 'Outlined', tone: 'good-seen' as const, meaning: 'Expected, but nobody has confirmed it yet.' },
  ANNOUNCED,
];
const googlebookViews = [
  { id: 'omarchy', label: 'Omarchy', question: `What Omarchy's packages ship for it today, and what owners reached.`, columns: GOOGLEBOOK_OMARCHY_LEGEND.map((group, i) => ({
    id: ['bootloader', 'tree', 'image', 'omarchy'][i],
    header: group.column,
    question: group.question,
    options: [FILTERS.bootloader, FILTERS.tree, FILTERS.linuxImage, FILTERS.googlebookOmarchy][i],
  })) },
  { id: 'upstream', label: 'Upstream', question: 'What Linux itself has, which every distro gets.', columns: [
    { id: 'device-tree', header: 'Linux', question: GOOGLEBOOK_UPSTREAM_LEGEND[0].question, options: FILTERS.googlebookDeviceTree },
  ] },
  hardwareView({ id: 'omarchy', header: GOOGLEBOOK_OMARCHY_LEGEND[3].column, question: GOOGLEBOOK_OMARCHY_LEGEND[3].question, options: FILTERS.googlebookOmarchy }),
];
const chromebookViews = [
  { ...googlebookViews[0], columns: [...googlebookViews[0].columns.map((column, i) => ({ ...column, question: CHROMEBOOK_OMARCHY_LEGEND[i].question })), HARDWARE_DOTS] },
  { ...googlebookViews[1], columns: [{ ...googlebookViews[1].columns[0], options: FILTERS.chromebookDeviceTree }] },
  hardwareView({ id: 'omarchy', header: CHROMEBOOK_OMARCHY_LEGEND[3].column, question: CHROMEBOOK_OMARCHY_LEGEND[3].question, options: FILTERS.googlebookOmarchy }),
];
// The Googlebooks' Omarchy view gets the row of dots too, after the Chromebooks took their own copy of its columns
googlebookViews[0].columns.push(HARDWARE_DOTS as never);
const HELP = 'mt-2 max-w-3xl text-sm text-zinc-400';
const models = progressModels();

const collected = new Date(status.collected).toISOString().slice(0, 10);
// Sources the last refresh couldn't reach, whose data is older than the rest
const stale: { part: string; since: string }[] = status.stale ?? [];
const STALE_NAME: Record<string, string> = { kernel: 'Linux and linux-next', ids: "systemd's hardware IDs", firmware: 'linux-firmware', acpi: 'The ACPI dumps', omarchy: "Omarchy's packages" };
const LINK = 'underline decoration-zinc-600 underline-offset-2 hover:text-zinc-100 hover:decoration-zinc-300';
const REPO = 'https://github.com/birkskyum/arewearmyet';
const NAV = 'rounded-full px-3 py-1 text-zinc-300 ring-1 ring-zinc-700 hover:bg-zinc-800 hover:text-zinc-100';
import { SHELL } from '../lib/shell';
---

<Layout home title="Are we ARM yet? Omarchy on ARM PCs, model by model" description="Which ARM PCs boot Omarchy today, what works on each, and what Omarchy ships for them.">
  <script is:inline slot="head" data-chips={PROGRESS_GROUPS.map((group) => group.key).join(' ')} data-uefi={PROGRESS_GROUPS.filter((group) => group.uefi).map((group) => group.key).join(' ')}>
    // The page opens in Hardware, which <html> carries from the start, unless its address names Bring-up
    // (view=bring-up) or one of a table's views within it (view=upstream, nvidia-view=upstream). This runs
    // before anything is painted
    if ([...new URLSearchParams(location.search)].some(([key, value]) => (key === 'view' || key.endsWith('-view')) && value !== 'hardware')) delete document.documentElement.dataset.mode;
    // A chip the address names (progress=c) hides the other sections from the start, as the bars' buttons do once
    // they have loaded. Bring-up has no bars for NVIDIA's and Google's machines, so it shows every section then
    (() => {
      const { chips, uefi } = document.currentScript.dataset;
      const chip = new URLSearchParams(location.search).get('progress');
      if (chip && chips.split(' ').includes(chip) && (uefi.split(' ').includes(chip) || document.documentElement.dataset.mode === 'hardware')) document.documentElement.dataset.progress = chip;
    })();
  </script>
  <style is:inline slot="head" set:html={PROGRESS_GROUPS.map((group) => `[data-progress="${group.key}"] [data-chips]:not([data-chips~="${group.key}"]) { display: none; }`).join('\n')}></style>
  <main class={`${SHELL} py-10`}>
    <header>
      <div class="flex items-start justify-between gap-4">
        <div class="flex items-center gap-4">
          <h1 class="text-4xl font-bold tracking-tight text-zinc-50 sm:text-5xl">Are we ARM yet?</h1>
        </div>
      </div>
      <p class="mt-3 text-lg text-zinc-400">Omarchy on ARM PCs, model by model.</p>
      <p class="mt-5 max-w-3xl text-sm text-zinc-400 hw:hidden">
        Every ARM laptop needs a device tree, hardware IDs and firmware. Omarchy ships them in its own packages, often before Linux, systemd and linux-firmware have them. The Omarchy view shows what Omarchy ships today, and the Upstream view what every distro gets. A check means Omarchy ships the piece, and pointing at it says which channel has it. Bootable says whether an owner reached the desktop. The newest fixes are on edge, the {image ? <a class={LINK} href={image.url}>nightly image</a> : 'nightly image'}, with <span class="whitespace-nowrap">linux-omarchy {status.omarchy.kernel}</span> and systemd {status.omarchy.systemd}. Booting is the first goal. Each model's page, behind its name, goes on to everything past booting, from sound and the camera to sleep and USB4, with what owners and their agents measured.
      </p>
      <p class="mt-5 hidden max-w-3xl text-sm text-zinc-400 hw:block">
        For each model, whether it boots Omarchy and what works once it does, from the screen, keyboard and Wi-Fi to sound, the camera, sleep and the ports. Bootable says whether an owner reached the desktop, or that it should boot and nobody has tried it yet. Every part's label is a result from Omarchy on that model, measured by <a class={LINK} href="/docs/hw-test">hw-test</a> or reported by an owner. Not tested means nobody has reported yet, and running hw-test on that model fills it in. Each model's page, behind its name, has every check with its source. What a model needs underneath, its device tree, hardware IDs and firmware, is under Bring-up.
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 rounded-xl bg-[#9ece6a]/10 px-5 py-4 ring-1 ring-[#9ece6a]/40">
        <p class="text-zinc-300"><strong class="font-semibold text-[#9ece6a]">Own an ARM laptop that isn't green yet?</strong> Help get it there, whatever distro you run. It only takes a few minutes.</p>
        <div class="flex flex-wrap gap-2 sm:shrink-0">
          <a href="/docs/install" class="rounded-md bg-[#9ece6a] px-4 py-2 text-sm font-semibold text-zinc-950 hover:brightness-110">How to install</a>
          <a href="/docs/help" class="rounded-md px-4 py-2 text-sm font-semibold text-[#9ece6a] ring-1 ring-[#9ece6a]/50 hover:bg-[#9ece6a]/10">How to help</a>
          <a href="/docs/agents" class="rounded-md px-4 py-2 text-sm font-semibold text-[#9ece6a] ring-1 ring-[#9ece6a]/50 hover:bg-[#9ece6a]/10">For AI agents</a>
        </div>
      </div>
    </header>

    <ModeSwitch>
      <ChipPills client:load groups={PROGRESS_GROUPS} counts={progressCounts(models)} />
    </ModeSwitch>

    <Progress client:load models={models} groups={PROGRESS_GROUPS} parts={PROGRESS_PARTS} />

    <Group id="snapdragon-pcs" chips="x1 x2 older c" title="Snapdragon PCs" total={current.length + older.length + entry.length}>
      Laptops, tablets and desktops sold with Windows or Linux. They start through UEFI and need a device tree, hardware IDs and firmware. Until Omarchy 4.6 is out, <a class={LINK} href="/docs/install">install from the edge image</a>, which has the newest fixes for these machines. <a class={LINK} href="#chromebooks-and-googlebooks">Chromebooks and Googlebooks</a> are further down.
    </Group>

    <Family id="snapdragon" chips="x1 x2" title="Snapdragon X1 and X2" total={current.length}>
      <div class="group/views" data-views data-view="hardware">
        <ViewState prefix="" views={snapdragonViews.map((v) => v.id)} />
        <div class="group-data-[view=hardware]/views:hidden group-data-[view=upstream]/views:hidden">
          <Legend title="What the labels mean" groups={OMARCHY_LEGEND} extra={legendExtra} />
        </div>
        <div class="hidden group-data-[view=hardware]/views:block">
          <Legend title="What the labels mean" groups={hardwareLegend(OMARCHY_LEGEND[0])} keys={HARDWARE_KEYS} />
        </div>
        <div class="hidden group-data-[view=upstream]/views:block">
          <Legend title="What the labels mean" groups={UPSTREAM_LEGEND} extra={legendExtra} />
        </div>
        <div class="mt-4">
          <StatusTable
            client:load
            rows={current}
            views={snapdragonViews}
            chips={[{ key: 'x1', label: 'Snapdragon X1' }, { key: 'x2', label: 'Snapdragon X2' }]}
            pageChips={['x1', 'x2']}
            urlPrefix=""
            exportName="arewearmyet-snapdragon-x"
            exportTitle="Snapdragon X1 and X2"
          />
        </div>
      </div>
    </Family>

    <Family id="snapdragon-7c-8cx-835-850" chips="older" title="Snapdragon 7c, 8cx, 835 and 850" total={older.length}>
      <p class="max-w-3xl text-sm text-zinc-400">
        The Windows on Arm machines from before Snapdragon X, with the Snapdragon 8cx, 850, 835 and 7c. They start through UEFI like the models above, so they need the same pieces and use the same views and labels. Omarchy carries device trees for most of them, from Linux, from owners' ports, or written from their ACPI tables.
      </p>
      <div class="group/views mt-4" data-views data-view="hardware">
        <ViewState prefix="8cx-" views={snapdragonViews.map((v) => v.id)} />
        <div>
          <StatusTable client:load rows={older} views={snapdragonViews} chips={[{ key: '8cx', label: '8cx Gen 3' }, { key: '8cx-gen1', label: '8cx Gen 1 and 2' }, { key: '850', label: '850' }, { key: '835', label: '835' }, { key: '7c', label: '7c' }]} urlPrefix="8cx-" exportName="arewearmyet-snapdragon-7c-8cx-835-850" exportTitle="Snapdragon 7c, 8cx, 835 and 850" />
        </div>
      </div>
    </Family>

    <Family id="snapdragon-c" chips="c" title="Snapdragon C" total={entry.length}>
      <p class="max-w-3xl text-sm text-zinc-400">
        Qualcomm's entry line for budget Windows laptops. Its drivers are the ones for the 7c Gen 3 (SC7280) in Arm Chromebooks, a chip Linux already describes, so each laptop needs a board tree, hardware IDs and firmware like the models above.
      </p>
      <div class="group/views mt-4" data-views data-view="hardware">
        <ViewState prefix="c-" views={snapdragonViews.map((v) => v.id)} />
        <div>
          <StatusTable client:load rows={entry} views={snapdragonViews} chips={[]} urlPrefix="c-" exportName="arewearmyet-snapdragon-c" exportTitle="Snapdragon C" />
        </div>
      </div>
    </Family>

    <Group id="nvidia-pcs" chips="n1x gb10" title="NVIDIA PCs" total={nvidia.length}>
      Laptops and desktops with NVIDIA's N1x and GB10 chips. They start through UEFI and describe their own hardware, so a model needs only a kernel with the drivers.
    </Group>

    <Family id="nvidia" chips="n1x gb10" title="NVIDIA N1x and GB10" total={nvidia.length}>
      <p class="max-w-3xl text-sm text-zinc-400">
        NVIDIA's ARM laptops and desktops start through ACPI, so they need no device tree or hardware IDs. Omarchy's kernel carries the patches they need, which Linux itself doesn't have yet, so what counts here is whether someone has booted into Omarchy on them.
      </p>
      <p class={HELP}>
        To help, install Omarchy's ARM image or another distro and report whether it boots, through <a class={LINK} href={`${REPO}/issues/new?template=model.yml`}>Add your model</a>. On Omarchy, <a class={LINK} href="/docs/hw-test">hw-test</a> checks the rest and puts the results on the model's page.
      </p>
      <div class="group/views mt-4" data-views data-view="hardware">
        <ViewState prefix="nvidia-" views={nvidiaViews.map((v) => v.id)} />
        <div class="group-data-[view=hardware]/views:hidden group-data-[view=upstream]/views:hidden">
          <Legend title="What the labels mean" groups={NVIDIA_OMARCHY_LEGEND} />
        </div>
        <div class="hidden group-data-[view=upstream]/views:block">
          <Legend title="What the labels mean" groups={NVIDIA_UPSTREAM_LEGEND} />
        </div>
        <div class="hidden group-data-[view=hardware]/views:block">
          <Legend title="What the labels mean" groups={hardwareLegend(NVIDIA_OMARCHY_LEGEND[1])} keys={HARDWARE_KEYS} />
        </div>
        <div class="mt-4">
          <StatusTable client:load rows={nvidia} views={nvidiaViews} chips={[{ key: 'n1x', label: 'NVIDIA N1x' }, { key: 'gb10', label: 'NVIDIA GB10' }]} pageChips={['n1x', 'gb10']} urlPrefix="nvidia-" exportName="arewearmyet-nvidia" exportTitle="NVIDIA N1x and GB10" />
        </div>
      </div>
    </Family>

    <Group id="chromebooks-and-googlebooks" chips="google" title="Chromebooks and Googlebooks" total={googlebooks.length + chromebooks.length}>
      They start through Google's own boot software instead of UEFI, so getting past the bootloader comes first.
    </Group>

    <Family id="googlebooks" chips="google" title="Googlebooks with Snapdragon" total={googlebooks.length}>
      <p class="max-w-3xl text-sm text-zinc-400">
        They use the same Snapdragon X Elite as the laptops above, but start like a Pixel, through Android's bootloader instead of UEFI. So they need no ACPI tables or hardware IDs, and Omarchy's ARM image doesn't start on them. They need a device tree and a Linux image built for that bootloader.
      </p>
      <p class={HELP}>
        To help, read the device tree Googlebook OS starts with, following the <a class={LINK} href="https://github.com/omacom/omarchy/discussions/16627">owner guide</a>. It changes nothing on the laptop.
      </p>
      <div class="group/views mt-4" data-views data-view="hardware">
        <ViewState prefix="googlebook-" views={googlebookViews.map((v) => v.id)} />
        <div class="group-data-[view=hardware]/views:hidden group-data-[view=upstream]/views:hidden">
          <Legend title="What the labels mean" groups={GOOGLEBOOK_OMARCHY_LEGEND} />
        </div>
        <div class="hidden group-data-[view=hardware]/views:block">
          <Legend title="What the labels mean" groups={hardwareLegend(GOOGLEBOOK_OMARCHY_LEGEND[3])} keys={HARDWARE_KEYS} />
        </div>
        <div class="hidden group-data-[view=upstream]/views:block">
          <Legend title="What the labels mean" groups={GOOGLEBOOK_UPSTREAM_LEGEND} />
        </div>
        <div class="mt-4">
          <StatusTable client:load rows={googlebooks} views={googlebookViews} chips={[{ key: 'x1', label: 'Snapdragon X1' }, { key: 'x2', label: 'Snapdragon X2' }]} urlPrefix="googlebook-" exportName="arewearmyet-googlebooks" exportTitle="Googlebooks with Snapdragon" />
        </div>
      </div>
    </Family>

    <Family id="chromebooks" chips="google" title="Chromebooks with Snapdragon" total={chromebooks.length}>
      <p class="max-w-3xl text-sm text-zinc-400">
        Arm Chromebooks start through ChromeOS's bootloader instead of UEFI, so like the Googlebooks they need no ACPI tables or hardware IDs, and Omarchy's ARM image doesn't start on them. Their device trees have been in Linux for years, so what they need is a Linux image built for that bootloader, which developer mode lets them start.
      </p>
      <div class="group/views mt-4" data-views data-view="hardware">
        <ViewState prefix="chromebook-" views={chromebookViews.map((v) => v.id)} />
        <div class="group-data-[view=hardware]/views:hidden group-data-[view=upstream]/views:hidden">
          <Legend title="What the labels mean" groups={CHROMEBOOK_OMARCHY_LEGEND} />
        </div>
        <div class="hidden group-data-[view=hardware]/views:block">
          <Legend title="What the labels mean" groups={hardwareLegend(CHROMEBOOK_OMARCHY_LEGEND[3])} keys={HARDWARE_KEYS} />
        </div>
        <div class="hidden group-data-[view=upstream]/views:block">
          <Legend title="What the labels mean" groups={GOOGLEBOOK_UPSTREAM_LEGEND} />
        </div>
        <div class="mt-4">
          <StatusTable client:load rows={chromebooks} views={chromebookViews} chips={[{ key: '7c', label: 'Snapdragon 7c' }]} urlPrefix="chromebook-" exportName="arewearmyet-chromebooks" exportTitle="Chromebooks with Snapdragon" />
        </div>
      </div>
    </Family>

    <Group id="apple" chips="" title="Apple Silicon">
      Macs with Apple's own chips are the Omarchy Mac team's. They install with <a class={LINK} href="https://github.com/omacom/omarchy-mac-installer">an installer of their own</a> and run Linux through Asahi Linux, whose <a class={LINK} href="https://asahilinux.org/docs/platform/feature-support/overview/">feature support pages</a> track which models and features work.
    </Group>

    <Group id="android" chips="" title="Android phones and tablets">
      Phones and tablets that came with Android belong to <a class={LINK} href="https://omamobile.org/devices/">Omarchy Mobile</a>, which lists the devices it runs on.
    </Group>

    <section class="mt-12 grid gap-8 text-sm text-zinc-400 sm:grid-cols-2">
      <div>
        <h2 class="text-base font-semibold text-zinc-100">What a model needs</h2>
        <p class="mt-2">
          ARM laptops don't describe their hardware to Linux the way PCs do, so each model needs a <strong class="text-zinc-200">device tree</strong>, written from its ACPI tables. Its <strong class="text-zinc-200">hardware IDs</strong> in systemd let a boot image pick that device tree by itself, and its <strong class="text-zinc-200">firmware</strong> files for the DSPs, GPU and Wi-Fi have to come from linux-firmware, from Windows, or from <a class={LINK} href="/firmware">the maker's own download</a>.
        </p>
      </div>
      <div>
        <h2 class="text-base font-semibold text-zinc-100">Where the data comes from</h2>
        <p class="mt-2">
          Collected {collected} from{' '}
          <a class={LINK} href="https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git/tree/arch/arm64/boot/dts/qcom">Linux</a> and linux-next {status.linuxNext},{' '}
          <a class={LINK} href="https://github.com/systemd/systemd/tree/main/src/boot/hwids/aa64">systemd's hardware IDs</a>,{' '}
          <a class={LINK} href="https://gitlab.com/kernel-firmware/linux-firmware/-/tree/main/qcom">linux-firmware</a>,{' '}
          <a class={LINK} href="https://github.com/aarch64-laptops/build/tree/HEAD/misc">aarch64-laptops</a>,{' '}
          <a class={LINK} href="https://github.com/turbineBMW/omarchy-hardware-reports">owners' hardware reports</a>{' '}
          and <a class={LINK} href="https://github.com/omacom/omarchy-pkgs">Omarchy's packages</a>.
        </p>
        {stale.length > 0 && (
          <p class="mt-2 text-amber-300/90">
            {stale.map((entry) => `${STALE_NAME[entry.part] ?? entry.part} couldn't be reached and is from ${entry.since.slice(0, 10)}`).join('; ')}.
          </p>
        )}
        <p class="mt-2">Made by the <a class={`${LINK} whitespace-nowrap`} href="https://omarchy.org"><OmarchyIcon class="mr-1 inline h-3.5 w-3.5 align-[-2px] text-[#9ece6a]" aria-hidden="true" />Omarchy</a> team. The code and data are <a class={LINK} href={REPO}>on GitHub</a>.</p>
        <div class="mt-4 flex flex-wrap gap-3">
          <a href={`${REPO}/issues/new?template=model.yml`} class="rounded-md px-3 py-1.5 text-zinc-200 ring-1 ring-zinc-700 hover:bg-zinc-800">Add your model</a>
          <a href={`${REPO}/blob/main/data/models.yaml`} class="rounded-md px-3 py-1.5 text-zinc-200 ring-1 ring-zinc-700 hover:bg-zinc-800">Edit the model list</a>
          <a href="/docs" class="rounded-md px-3 py-1.5 text-zinc-200 ring-1 ring-zinc-700 hover:bg-zinc-800">Docs and API</a>
        </div>
      </div>
    </section>
  </main>
