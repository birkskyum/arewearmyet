---
// One note written by an owner or an agent, with its answers and logs. Which one is in the
// address (/note?id=NOTE-...), read in the browser, since notes arrive after the site is built.
import Layout from '../layouts/Layout.astro';
import ChipIcon from '../assets/chip-icon.svg';
import NoteView from '../components/NoteView';
---

<Layout title="Note · Are we ARM yet?" description="A problem, workaround or pointer an owner or their agent wrote down about a computer model.">
  <main class="mx-auto max-w-4xl px-4 py-10 text-zinc-400 sm:px-6">
    <a href="/" class="flex items-center gap-3 text-zinc-300 hover:text-zinc-100">
      <ChipIcon class="h-8 w-8 text-[#9ece6a]" aria-hidden="true" />
      <span class="font-semibold">Are we ARM yet?</span>
    </a>
    <NoteView client:load />
  </main>
</Layout>
