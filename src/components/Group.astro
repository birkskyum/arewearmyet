---
// The heading of a group of families that start the same way, which are Snapdragon PCs, NVIDIA PCs,
// Chromebooks and Googlebooks. The line under it says what is in the group and how it starts.
// A group this site doesn't cover (Apple Silicon, Android) has no count and only points elsewhere.

interface Props {
  id: string;
  title: string;
  total?: number;
}

const { id, title, total } = Astro.props;
---

<div id={id} class="mt-20 scroll-mt-20 first-of-type:mt-14">
  <h2 class="text-2xl font-bold tracking-tight text-zinc-50 sm:text-3xl">{title}{total !== undefined && <span class="font-normal text-zinc-500"> {total}</span>}</h2>
  <p class="mt-2 max-w-3xl text-sm text-zinc-400"><slot /></p>
</div>
