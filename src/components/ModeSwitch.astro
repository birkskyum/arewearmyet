---
// The page-wide switch between What works (the hardware mode), which the page opens in, and Bring-up. It stays at the top while the
// page scrolls, and every section follows the switch (bars, legends and tables). The mode is on the <html> element (src/lib/mode.ts),
// so the active side is styled with the hw: variant and no script redraws it. The chip buttons above the bars choose the groups shown.
const SIDE = 'rounded-md px-4 py-1.5 text-sm font-semibold';
---

<div class="sticky top-0 z-30 -mx-4 mt-8 border-y border-zinc-800 bg-zinc-950/90 px-4 py-3 backdrop-blur sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8" data-mode-switch>
  <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
    <div class="inline-flex rounded-lg bg-zinc-900 p-0.5 ring-1 ring-zinc-700" role="group" aria-label="What the page shows">
      <button type="button" data-set-mode="hardware" aria-pressed="true" class={`${SIDE} text-zinc-300 hover:bg-zinc-800 hover:text-zinc-100 hw:bg-zinc-100 hw:text-zinc-900 hw:hover:bg-zinc-100 hw:hover:text-zinc-900`}>What works</button>
      <button type="button" data-set-mode="booting" aria-pressed="false" class={`${SIDE} bg-zinc-100 text-zinc-900 hw:bg-transparent hw:text-zinc-300 hw:hover:bg-zinc-800 hw:hover:text-zinc-100`}>Bring-up</button>
    </div>
    <p class="ml-auto text-sm text-zinc-400 max-lg:hidden hw:hidden">What does it need? The device tree, hardware IDs and firmware of each model.</p>
    <p class="ml-auto hidden text-sm text-zinc-400 lg:hw:block">Does it boot, and what works? Each part, as owners and <code class="rounded bg-zinc-800 px-1 py-0.5 text-xs text-zinc-200">hw-test</code> found it.</p>
  </div>
</div>

<script>
  import { MODE_EVENT, readMode, setMode, type Mode } from '../lib/mode';

  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-set-mode]');
  const mark = () => buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.setMode === readMode())));
  buttons.forEach((button) => button.addEventListener('click', () => setMode(button.dataset.setMode as Mode)));
  addEventListener(MODE_EVENT, mark);
  mark();
</script>
