---
// What every column and label means, folded under a bar that keeps the colour key in view.
// The cells show the same text on hover.
import { TONE } from '../lib/labels';

interface Props {
  title: string;
  groups: { column: string; question: string; states: { label: string; tone: keyof typeof TONE; meaning: string }[] }[];
  extra?: { label: string; tone: keyof typeof TONE; meaning: string }[];
}

const { title, groups, extra } = Astro.props;
const PILL = 'inline-flex shrink-0 items-center whitespace-nowrap rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset';
const CARD = 'rounded-lg bg-zinc-950/60 p-4 ring-1 ring-zinc-800';
const KEY = [
  { dot: 'bg-emerald-400', text: 'done' },
  { dot: 'bg-amber-400', text: 'on its way' },
  { dot: 'bg-rose-400', text: 'missing' },
  { dot: 'bg-zinc-500', text: 'another way or not needed' },
];
---

<details class="group rounded-xl bg-zinc-900 ring-1 ring-zinc-800">
  <summary class="flex cursor-pointer list-none flex-wrap items-center gap-x-6 gap-y-2 px-5 py-3.5 [&::-webkit-details-marker]:hidden">
    <span class="text-sm font-semibold text-zinc-100">{title}</span>
    <span class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-zinc-400">
      {KEY.map((key) => (
        <span class="inline-flex items-center gap-1.5"><span class={`h-2 w-2 rounded-full ${key.dot}`}></span>{key.text}</span>
      ))}
    </span>
    <span class="ml-auto inline-flex items-center gap-1 text-xs text-zinc-400 group-hover:text-zinc-200">
      <span class="group-open:hidden">Show</span><span class="hidden group-open:inline">Hide</span>
      <svg class="h-4 w-4 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.17l3.71-3.94a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" /></svg>
    </span>
  </summary>
  <div class="grid gap-3 px-5 pb-5 sm:grid-cols-2 lg:grid-cols-3">
    {groups.map((group) => (
      <div class={CARD}>
        <h3 class="text-sm font-semibold text-zinc-100">{group.column}</h3>
        <p class="mt-0.5 text-xs text-zinc-400">{group.question}</p>
        <dl class="mt-3 space-y-2">
          {group.states.map((state) => (
            <div class="flex items-start gap-2">
              <dt class={`${PILL} ${TONE[state.tone]}`}>{state.label}</dt>
              <dd class="text-xs leading-5 text-zinc-400">{state.meaning}</dd>
            </div>
          ))}
        </dl>
      </div>
    ))}
    {extra && (
      <div class={CARD}>
        <h3 class="text-sm font-semibold text-zinc-100">Colours and badges</h3>
        <p class="mt-0.5 text-xs text-zinc-400">Every label also explains itself when you point at it.</p>
        <dl class="mt-3 space-y-2">
          {extra.map((state) => (
            <div class="flex items-start gap-2">
              <dt class={`${PILL} ${TONE[state.tone]}`}>{state.label}</dt>
              <dd class="text-xs leading-5 text-zinc-400">{state.meaning}</dd>
            </div>
          ))}
        </dl>
      </div>
    )}
  </div>
</details>
