---
// A page of running text written in Markdown: the agent guide and the reference pages under /docs.
// The same text is served as plain Markdown at the address given as `plain`.
import DocsLayout from './DocsLayout.astro';

interface Props {
  title: string;
  description: string;
  plain: string;
  headings?: { depth: number; slug: string; text: string }[];
}
const { title, description, plain, headings = [] } = Astro.props;
const LINK = 'underline decoration-zinc-600 underline-offset-2 hover:text-zinc-100 hover:decoration-zinc-300';
// The link that ends every heading is not part of its text
const sections = headings.filter((h) => h.depth === 2 || h.depth === 3).map((h) => ({ id: h.slug, text: h.text.replace(/#$/, ''), depth: h.depth }));
---

<DocsLayout title={title} description={description} sections={sections}>
  <slot name="top" />
  <article class="guide">
    <slot />
  </article>
  <p class="mt-10 text-xs text-zinc-500">
    Plain text for agents: <a class={LINK} href={plain}>{plain}</a> · <a class={LINK} href="/llms.txt">/llms.txt</a>
  </p>
</DocsLayout>
