---
// The frame of every documentation page: the docs pages in a sidebar on the left, the page in
// the middle, and the page's own sections on the right. On a narrow screen both lists fold into
// one menu above the page.
import Layout from './Layout.astro';
import { DOC_GROUPS } from '../lib/docs';
import { SHELL } from '../lib/shell';

interface Props {
  title: string;
  description: string;
  // The page's sections, for the list on the right. depth 2 is a section, 3 a part of one
  sections?: { id: string; text: string; depth?: number }[];
}
const { title, description, sections = [] } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const ITEM = 'block rounded-md px-2.5 py-1.5 hover:bg-zinc-900 hover:text-zinc-100';
const ON = 'bg-zinc-900 font-medium text-zinc-100';
const GROUP = 'px-2.5 text-xs font-semibold uppercase tracking-wide text-zinc-500';
---

<Layout title={title} description={description}>
  <div class={`${SHELL} lg:grid lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-10 xl:grid-cols-[13rem_minmax(0,1fr)_13rem]`}>
    {/* On a phone or a narrow window, one menu holds both lists */}
    <details class="group mt-4 rounded-lg bg-zinc-900 text-sm text-zinc-400 ring-1 ring-zinc-800 lg:hidden">
      <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-2.5 font-medium text-zinc-200 [&::-webkit-details-marker]:hidden">
        Docs menu
        <span class="text-zinc-500 group-open:rotate-180" aria-hidden="true">▾</span>
      </summary>
      <nav class="space-y-4 border-t border-zinc-800 px-2 py-3" aria-label="Docs">
        {DOC_GROUPS.map((group) => (
          <div>
            <p class={GROUP}>{group.title}</p>
            <ul class="mt-1">
              {group.pages.map((page) => (
                <li>
                  <a href={page.href} class={`${ITEM} ${page.href === path ? ON : ''}`} aria-current={page.href === path ? 'page' : undefined}>{page.title}</a>
                  {page.href === path && sections.length > 0 && (
                    <ul class="mb-1 ml-3 border-l border-zinc-800 pl-2">
                      {sections.filter((section) => (section.depth ?? 2) === 2).map((section) => <li><a href={`#${section.id}`} class="block px-2 py-1 hover:text-zinc-100">{section.text}</a></li>)}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </details>

    <aside class="hidden lg:block">
      <nav class="sticky top-6 -ml-2.5 max-h-[calc(100vh-3rem)] space-y-5 overflow-y-auto py-10 text-sm text-zinc-400" aria-label="Docs">
        <a href="/docs" class={`${ITEM} ${path === '/docs' ? ON : 'text-zinc-300'}`}>Docs overview</a>
        {DOC_GROUPS.map((group) => (
          <div>
            <p class={GROUP}>{group.title}</p>
            <ul class="mt-1.5 space-y-0.5">
              {group.pages.map((page) => (
                <li><a href={page.href} class={`${ITEM} ${page.href === path ? ON : ''}`} aria-current={page.href === path ? 'page' : undefined}>{page.title}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </aside>

    <main class="min-w-0 max-w-3xl py-8 text-zinc-400 lg:py-10">
      <slot />
    </main>

    {sections.length > 0 && (
      <aside class="hidden xl:block">
        <nav class="sticky top-6 max-h-[calc(100vh-3rem)] overflow-y-auto py-10 text-sm text-zinc-500" aria-label="On this page" data-toc>
          <p class="text-xs font-semibold uppercase tracking-wide text-zinc-500">On this page</p>
          <ul class="mt-2 space-y-1 border-l border-zinc-800">
            {sections.map((section) => (
              <li><a href={`#${section.id}`} class={`-ml-px block border-l border-transparent py-0.5 hover:text-zinc-200 ${(section.depth ?? 2) === 3 ? 'pl-6' : 'pl-3'}`}>{section.text}</a></li>
            ))}
          </ul>
        </nav>
      </aside>
    )}
  </div>
</Layout>

<script>
  // The list on the right marks the section being read
  const toc = document.querySelector('[data-toc]');
  if (toc) {
    const links = new Map<string, HTMLAnchorElement>();
    for (const link of toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')) links.set(decodeURIComponent(link.hash.slice(1)), link);
    const mark = (id: string) => {
      for (const [key, link] of links) {
        link.classList.toggle('text-zinc-100', key === id);
        link.classList.toggle('border-zinc-400', key === id);
        link.classList.toggle('border-transparent', key !== id);
      }
    };
    const targets = [...links.keys()].map((id) => document.getElementById(id)).filter((el): el is HTMLElement => Boolean(el));
    const watch = () => {
      // The last section whose top has passed the upper third of the window
      const line = window.innerHeight / 3;
      const current = targets.filter((el) => el.getBoundingClientRect().top <= line).pop() ?? targets[0];
      if (current) mark(current.id);
    };
    document.addEventListener('scroll', watch, { passive: true });
    watch();
  }
</script>

<style is:global>
  /* The docs' own typography. Every docs page puts its text in an article of this class */
  .guide { line-height: 1.7; }
  .guide h1 { color: rgb(250 250 250); font-size: 1.9rem; font-weight: 700; letter-spacing: -0.02em; }
  .guide h2 { color: rgb(244 244 245); font-size: 1.25rem; font-weight: 600; margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid rgb(39 39 42); scroll-margin-top: 1.5rem; }
  .guide h3 { color: rgb(228 228 231); font-size: 1.05rem; font-weight: 600; margin-top: 1.75rem; scroll-margin-top: 1.5rem; }
  .guide p, .guide ul, .guide ol, .guide table, .guide pre { margin-top: 0.9rem; }
  .guide ul { list-style: disc; padding-left: 1.4rem; }
  .guide ol { list-style: decimal; padding-left: 1.4rem; }
  .guide li { margin-top: 0.35rem; }
  .guide li::marker { color: rgb(113 113 122); }
  .guide strong { color: rgb(228 228 231); }
  .guide a { text-decoration: underline; text-decoration-color: rgb(82 82 91); text-underline-offset: 2px; }
  .guide a:hover { color: rgb(244 244 245); text-decoration-color: rgb(212 212 216); }
  .guide .anchor { margin-left: 0.5rem; color: rgb(82 82 91); text-decoration: none; opacity: 0; transition: opacity 0.1s; }
  .guide :is(h1, h2, h3):hover .anchor, .guide .anchor:focus-visible { opacity: 1; }
  .guide code { background: rgb(39 39 42); border-radius: 0.25rem; padding: 0.1rem 0.3rem; font-size: 0.85em; color: rgb(228 228 231); }
  /* A long address in running text or a heading breaks rather than widening the page on a phone */
  .guide :not(pre) > code { overflow-wrap: anywhere; }
  .guide pre { background: rgb(9 9 11) !important; border-radius: 0.5rem; padding: 0.9rem; overflow-x: auto; font-size: 0.8rem; line-height: 1.55; border: 1px solid rgb(39 39 42); }
  .guide pre code { background: none; padding: 0; font-size: inherit; }
  .guide table { width: 100%; border-collapse: collapse; font-size: 0.875rem; display: block; overflow-x: auto; }
  .guide th { text-align: left; color: rgb(228 228 231); font-weight: 600; border-bottom: 1px solid rgb(63 63 70); padding: 0.5rem 0.75rem 0.5rem 0; }
  .guide td { border-bottom: 1px solid rgb(39 39 42); padding: 0.5rem 0.75rem 0.5rem 0; vertical-align: top; }
</style>
