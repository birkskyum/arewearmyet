+
+	pmc8180e_adc: adc@3100 {
+		compatible = "qcom,spmi-adc5";
+		reg = <0x3100>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		#io-channel-cells = <1>;
+		interrupts = <0x8 0x31 0x0 IRQ_TYPE_EDGE_RISING>;
+
+		ref-gnd@0 {
+			reg = <ADC5_REF_GND>;
