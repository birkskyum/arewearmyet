+			compatible = "shared-dma-pool";
+			size = <0x0 0x8000000>;
+			reusable;
+			linux,cma-default;
+		};
+	};
+
+	sound {
+		compatible = "qcom,x1e80100-sndcard";
+		model = "X1E78100-ACER-Swift-Go-SFA14-11";
+		audio-routing = "WooferLeft IN", "WSA WSA_SPK1 OUT",
